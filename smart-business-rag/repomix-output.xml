import uuid
from typing import List, Optional
from pydantic import BaseModel, Field

# --- CITATION & CORE INSIGHT MODELS ---
class Citation(BaseModel):
    """Represents an auditable source citation from a filing."""
    document: str = Field(description="The source file name, e.g., 'nubank-3q25.pdf'")
    page: int = Field(description="The exact 1-indexed page number in the filing")
    quote: str = Field(description="The exact snippet or metric quoted from the text")

class OperationalInsight(BaseModel):
    """The structured output generated by the financial synthesis engine."""
    answer: str = Field(description="Executive summary answering the user query.")
    citations: List[Citation] = Field(default_factory=list, description="List of source citations.")
    is_grounded: bool = Field(default=True, description="Whether the answer is backed by documents.")

# --- API SPECIFIC SCHEMAS ---
class QueryRequest(BaseModel):
    """Payload sent by the client when asking a business question."""
    query: str = Field(
        min_length=3,
        description="The business/operational question to ask",
        examples=["What are Nubank's customer growth metrics in Mexico?"]
    )
    fiscal_filter: Optional[str] = Field(
        default=None,
        description="Filter by quarter (e.g. 3Q25, 4Q25)",
        examples=["4Q25"]
    )
    thread_id: Optional[str] = Field(
        default=None,
        description="Optional session ID for conversational memory. If omitted, a new session is generated.",
        examples=["session-abc-123"]
    )

class QueryResponse(BaseModel):
    """Standardized API response containing the insight, thread ID, and execution metadata."""
    query: str
    fiscal_filter: Optional[str]
    thread_id: str = Field(description="Active session thread ID for subsequent follow-up queries.")
    insight: OperationalInsight

class DocumentUploadResponse(BaseModel):
    """Response returned after processing and embedding a PDF."""
    filename: str
    pages_extracted: int
    chunks_indexed: int
    message: str

class HealthResponse(BaseModel):
    """System health check payload."""
    status: str
    database_connected: bool
    version: str
