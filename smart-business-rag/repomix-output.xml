version: '3.8'

services:
  backend:
    build: .
    container_name: smart-rag-backend
    restart: unless-stopped
    ports:
      - "8000:8000"
    env_file:
      - .env
    command: ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8000/api/v1/health || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 3

  frontend:
    build: .
    container_name: smart-rag-frontend
    restart: unless-stopped
    ports:
      - "8501:8501"
    env_file:
      - .env
    environment:
      # Tells the Streamlit container to communicate with the backend container
      - API_BASE_URL=http://backend:8000/api/v1
    depends_on:
      - backend
    command: ["uv", "run", "streamlit", "run", "app/frontend/ui.py", "--server.port=8501", "--server.address=0.0.0.0"]
