# Google AI Studio
GOOGLE_API_KEY='YOUR_KEY_HERE'

# Groq Console
GROQ_API_KEY='YOUR_KEY_HERE'

# Vector Database (Local Docker or Supabase URI)
DATABASE_URL=YOUR_DATABASE_URL_HERE

